{
  "name": "dtrim",
  "version": "0.0.0-development",
  "description": "A tool for trimming deep/lengthy javascript structures. Some potential usages are: debugging, logging or data sanitization.",
  "keywords": [
    "trimming",
    "sanitization",
    "sanitize",
    "deep trim",
    "truncate"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "rm -rf lib && tsc",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "benchmark": "tsx tools/benchmark.ts",
    "semantic-release": "semantic-release"
  },
  "files": [
    "lib"
  ],
  "repository": "https://github.com/runk/dtrim",
  "author": "Dmitry Shirokov <deadrunk@gmail.com>",
  "contributors": [
    "Sam Chung @samchungy"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/benchmark": "2.1.5",
    "@types/lodash": "4.17.25",
    "@types/node": "24.19.0",
    "benchmark": "2.1.4",
    "lodash": "4.18.1",
    "prettier": "^3.0.0",
    "semantic-release": "25.0.9",
    "tsx": "^4.23.15",
    "vitest": "^5.0.0",
    "typescript": "7.0.2"
  },
  "dependencies": {}
}
